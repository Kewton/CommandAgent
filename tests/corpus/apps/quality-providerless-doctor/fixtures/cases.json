      "id": "BB-DOC-001",
      "area": "doctor",
      "purpose": "Doctor with unreachable Ollama fails honestly with non-zero exit",
      "source": "docs/guide/ja/cli-reference.md#フラグ一覧",
      "setup": [],
      "command": "\"$BIN\" --doctor --ollama-host \"$OLLAMA_UNREACHABLE\" </dev/null",
      "timeout_sec": 60,
      "expected": {
        "exit_code": "nonzero",
        "stdout_contains": [
          "CommandAgent doctor: failed",
          "✗ Ollama"
        ],
        "stderr_contains": [
          "doctor found failed checks"
        ],
        "must_not_contain": [
          "panicked at"
        ],
        "files_exist": [],
        "files_absent": []
      }
