{
  "kind": "synthetic",
  "note": "Hand-authored scripted cases. Thresholds are expressed relative to the write_required threshold (T); budgets are repair turn budgets. Each case names the test that runs it.",
  "write_required_threshold": 7,
  "cases": [
    {
      "id": "seeded-verify-repair-read-then-write",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Read", "Write fix"],
      "expected": ["turn=1 Read executed", "feedback stage=write_required read_only_streak=T-1", "turn=2 Write ok", "source fixed"],
      "test": "seeded_verify_repair_first_request_carries_advisory_without_enforcement"
    },
    {
      "id": "seeded-verify-repair-write-first",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok", "source fixed", "host re-verification decides the step"],
      "test": "first_reply_write_fixes_the_source_after_the_advisory"
    },
    {
      "id": "seeded-verify-repair-reads-only",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Read", "Read", "Read"],
      "expected": ["turn=1 Read executed", "feedback stage=write_required read_only_streak=T-1", "turn=2 Read rejected attempts=1", "turn=3 Read rejected attempts=2", "stop reason=model_stagnation:read_only_loop write_required_no_write_attempts=2", "source unchanged", "recovery artifacts saved as before"],
      "test": "reads_after_the_advisory_stop_exactly_as_before"
    },
    {
      "id": "seeded-verify-repair-anchor-failures",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Read", "Edit missing anchor", "Read", "Edit missing anchor", "Read"],
      "expected": ["turn=1 Read executed", "feedback stage=write_required read_only_streak=T-1", "turn=2 Edit failed=edit_anchor_not_found", "turn=3 Read rejected attempts=1", "turn=4 Edit failed=edit_anchor_not_found", "turn=5 Read rejected attempts=2", "stop reason=model_stagnation:read_only_loop write_required_no_write_attempts=2", "source unchanged"],
      "test": "failed_anchor_edits_keep_existing_counters_and_stop"
    },
    {
      "id": "seeded-verify-repair-write-keeps-failure",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Write unrelated path"],
      "expected": ["original failure kept", "not a success"],
      "test": "write_that_leaves_the_failure_does_not_turn_into_success"
    },
    {
      "id": "fresh-carry-budget-equal-threshold",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T",
      "expected_initial_streak": "0",
      "pre_advanced": false,
      "first_request_strong_feedback": false,
      "first_request_advisory": false,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "budget_relative_to_threshold_decides_the_advisory"
    },
    {
      "id": "fresh-carry-budget-above-threshold",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T+1",
      "expected_initial_streak": "0",
      "pre_advanced": false,
      "first_request_strong_feedback": false,
      "first_request_advisory": false,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "budget_relative_to_threshold_decides_the_advisory"
    },
    {
      "id": "carried-streak-threshold-minus-two",
      "session": "implement_repair",
      "carried": {"read_only_streak": "T-2"},
      "budget": "T+1",
      "expected_initial_streak": "T-2",
      "pre_advanced": false,
      "first_request_strong_feedback": false,
      "first_request_advisory": false,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "carried_streak_below_threshold_minus_one_gets_no_advisory"
    },
    {
      "id": "real-carry-threshold-minus-one",
      "session": "verify_repair",
      "carried": {"read_only_streak": "T-1"},
      "budget": "T+1",
      "expected_initial_streak": "T-1",
      "pre_advanced": false,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "real_carry_and_carried_exhaustion_both_get_the_advisory"
    },
    {
      "id": "carried-write-required-exhaustion",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0, "write_required_exhausted": true},
      "budget": "T+1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "real_carry_and_carried_exhaustion_both_get_the_advisory"
    },
    {
      "id": "verify-repair-at-threshold-strong-feedback-wins",
      "session": "verify_repair",
      "carried": {"read_only_streak": "T"},
      "budget": "T+1",
      "expected_initial_streak": "T",
      "pre_advanced": false,
      "first_request_strong_feedback": true,
      "first_request_advisory": false,
      "replies": ["Write fix"],
      "expected": ["feedback stage=write_required read_only_streak=T before turn=1"],
      "test": "stronger_first_request_feedback_wins_and_keeps_its_counters"
    },
    {
      "id": "verify-repair-anchor-interlock-wins",
      "session": "verify_repair",
      "carried": {"read_only_streak": "T", "anchor_failures": 1},
      "budget": "T+1",
      "expected_initial_streak": "T",
      "pre_advanced": false,
      "first_request_strong_feedback": true,
      "first_request_advisory": false,
      "replies": ["Write fix"],
      "expected": ["feedback selection_reason=anchor_failure before turn=1"],
      "test": "stronger_first_request_feedback_wins_and_keeps_its_counters"
    },
    {
      "id": "implement-repair-at-threshold",
      "session": "implement_repair",
      "carried": {"read_only_streak": "T"},
      "budget": "T+1",
      "expected_initial_streak": "T",
      "pre_advanced": false,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "implement_repair_at_threshold_gets_the_advisory"
    },
    {
      "id": "sessions-without-carryover",
      "session": "verify_observation, inspect, implement, final_acceptance_repair without carry, minimal_loop",
      "carried": null,
      "budget": "T-1",
      "expected_initial_streak": "0",
      "pre_advanced": false,
      "first_request_strong_feedback": false,
      "first_request_advisory": false,
      "replies": ["Write fix"],
      "expected": ["no escalation_carryover event"],
      "test": "sessions_without_carryover_get_no_advisory"
    },
    {
      "id": "final-acceptance-repair-with-carry",
      "session": "final_acceptance_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["Write fix"],
      "expected": ["turn=1 Write ok"],
      "test": "carry_bearing_final_acceptance_repair_gets_the_advisory_and_still_needs_a_write"
    },
    {
      "id": "xml-fallback-tools",
      "session": "verify_repair",
      "carried": {"read_only_streak": 0},
      "budget": "T-1",
      "expected_initial_streak": "T-1",
      "pre_advanced": true,
      "first_request_strong_feedback": false,
      "first_request_advisory": true,
      "replies": ["XML Write fix"],
      "expected": ["advisory is the last user message with native tools and with XML fallback"],
      "test": "native_and_xml_fallback_requests_both_carry_the_advisory"
    }
  ]
}
