{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kewton/commandmate-skills/blob/main/skills/cmate-worktree-cleanup/schemas/cleanup-result.v2.json",
  "title": "cmate-worktree-cleanup result (version 2)",
  "description": "Closed cleanup receipt. Version 2 represents dry-run deletable targets as pending_confirmation and separates CommandMate reported counts from reported ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "skill",
    "generated_at",
    "status",
    "mode",
    "profile",
    "request",
    "confirmation",
    "fetch",
    "removed",
    "skipped",
    "worktree_prune",
    "commandmate_sync",
    "next_actions",
    "blocking_reasons",
    "limitations",
    "completion_check",
    "summary_markdown"
  ],
  "properties": {
    "result_schema_version": { "const": 2 },
    "skill": { "$ref": "#/$defs/skill" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["success", "partial", "failure"] },
    "mode": { "enum": ["dry_run", "apply"] },
    "profile": { "$ref": "#/$defs/profile" },
    "request": { "$ref": "#/$defs/request" },
    "confirmation": { "$ref": "#/$defs/confirmation" },
    "fetch": { "$ref": "#/$defs/fetch" },
    "removed": { "type": "array", "items": { "$ref": "#/$defs/removal" } },
    "skipped": { "type": "array", "items": { "$ref": "#/$defs/skip" } },
    "worktree_prune": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ran"],
      "properties": { "ran": { "type": "boolean" } }
    },
    "commandmate_sync": { "$ref": "#/$defs/commandmate_sync" },
    "next_actions": { "type": "array", "items": { "$ref": "#/$defs/next_action" } },
    "blocking_reasons": { "$ref": "#/$defs/messages" },
    "limitations": { "$ref": "#/$defs/messages" },
    "completion_check": { "$ref": "#/$defs/completion_check" },
    "summary_markdown": { "type": "string", "minLength": 1, "maxLength": 20000 }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "dry_run" } }, "required": ["mode"] },
      "then": { "properties": { "removed": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "cmate-worktree-cleanup" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "git_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
    "worktree_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "messages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verified", "base", "remote"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "verified": { "type": "boolean" },
        "base": { "$ref": "#/$defs/git_ref" },
        "remote": { "type": "string", "minLength": 1, "maxLength": 100 },
        "baseline": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_mode", "targets"],
      "properties": {
        "selection_mode": { "enum": ["issues", "all_eligible"] },
        "targets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded", "remote", "base"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": "boolean" },
        "remote": { "type": "string", "minLength": 1, "maxLength": 100 },
        "base": { "$ref": "#/$defs/git_ref" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "granted", "granted_targets"],
      "properties": {
        "required": { "const": true },
        "granted": { "type": ["boolean", "null"] },
        "granted_targets": { "type": "array", "items": { "$ref": "#/$defs/worktree_ref" } },
        "note": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_ref",
        "branch",
        "tip",
        "proof_type",
        "method",
        "worktree_removed",
        "branch_deleted",
        "evidence"
      ],
      "properties": {
        "worktree_ref": { "$ref": "#/$defs/worktree_ref" },
        "issue_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 },
        "branch": { "$ref": "#/$defs/git_ref" },
        "tip": { "$ref": "#/$defs/git_oid" },
        "proof_type": { "enum": ["direct", "merged_equivalent"] },
        "method": { "enum": ["direct_branch_d", "guarded_ref_delete"] },
        "worktree_removed": { "type": "boolean" },
        "branch_deleted": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/removal_evidence" }
      }
    },
    "removal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "verified_at"],
      "properties": {
        "base": { "$ref": "#/$defs/git_ref" },
        "verified_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Per-target timestamp captured immediately after the final drift check and before that target's deletion; never copied from the run receipt timestamp."
        },
        "ancestor_verified": { "type": ["boolean", "null"] },
        "pr_number": { "type": ["integer", "null"], "minimum": 1 },
        "merge_commit_oid": { "anyOf": [{ "$ref": "#/$defs/git_oid" }, { "type": "null" }] },
        "expected_old_oid": { "anyOf": [{ "$ref": "#/$defs/git_oid" }, { "type": "null" }] }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_ref", "branch", "reason", "proof_type"],
      "properties": {
        "worktree_ref": { "$ref": "#/$defs/worktree_ref" },
        "issue_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 },
        "branch": { "anyOf": [{ "$ref": "#/$defs/git_ref" }, { "type": "null" }] },
        "reason": { "$ref": "#/$defs/skip_reason" },
        "proof_type": { "enum": ["direct", "merged_equivalent", "unverifiable", "excluded"] },
        "detail": { "type": ["string", "null"], "maxLength": 300 }
      },
      "allOf": [
        {
          "if": { "properties": { "reason": { "const": "pending_confirmation" } }, "required": ["reason"] },
          "then": { "properties": { "proof_type": { "enum": ["direct", "merged_equivalent"] } } }
        },
        {
          "if": {
            "properties": {
              "reason": { "enum": ["current_worktree", "main_worktree", "integration_worktree", "not_in_scope"] }
            },
            "required": ["reason"]
          },
          "then": { "properties": { "proof_type": { "const": "excluded" } } }
        }
      ]
    },
    "skip_reason": {
      "enum": [
        "pending_confirmation",
        "current_worktree",
        "main_worktree",
        "integration_worktree",
        "not_in_scope",
        "dirty",
        "detached",
        "unmerged",
        "unverifiable",
        "fetch_failed",
        "github_data_missing",
        "no_merged_pr",
        "multiple_prs",
        "head_oid_drift",
        "merge_commit_unreachable",
        "tree_mismatch",
        "plan_drift",
        "locked",
        "missing",
        "command_failed"
      ]
    },
    "commandmate_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "outcome",
        "ids_reported",
        "reported_removed_count",
        "worktree_ids"
      ],
      "properties": {
        "attempted": { "type": "boolean" },
        "outcome": { "enum": ["synced", "unavailable", "failed", "skipped"] },
        "ids_reported": {
          "type": "boolean",
          "description": "Whether the CLI explicitly returned reconciled worktree ids. False permits a successful count-only response without fabricating ids."
        },
        "reported_removed_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Count reported by the CLI, or null when no count was reported. It is not inferred from worktree_ids."
        },
        "worktree_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": "Only ids explicitly reported by the CLI. Empty when ids_reported is false, including successful count-only sync."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ids_reported": { "const": false } }, "required": ["ids_reported"] },
          "then": { "properties": { "worktree_ids": { "maxItems": 0 } } }
        }
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": { "type": "string", "minLength": 1, "maxLength": 300 },
        "reason": { "enum": ["dirty", "detached", "unmerged", "unverifiable", "server", "process", "tmux", "database", "log", "sync"] },
        "worktree_ref": { "anyOf": [{ "$ref": "#/$defs/worktree_ref" }, { "type": "null" }] }
      }
    },
    "completion_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed", "detail"],
            "properties": {
              "id": {
                "enum": [
                  "exclusions_honored",
                  "zero_delete_honored",
                  "proof_sufficient",
                  "guarded_delete_used",
                  "drift_rechecked",
                  "no_sensitive_values"
                ]
              },
              "passed": { "type": "boolean" },
              "detail": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    }
  }
}
