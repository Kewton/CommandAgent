{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kewton/commandmate-skills/blob/main/skills/cmate-worktree-cleanup/schemas/cleanup-plan.v2.json",
  "title": "cmate-worktree-cleanup plan (version 2)",
  "description": "Closed dry-run plan contract. Version 2 adds an explicit main_worktree exclusion while preserving the v1 proof model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_schema_version",
    "skill",
    "generated_at",
    "mode",
    "profile",
    "request",
    "fetch",
    "candidates",
    "excluded",
    "blocking_reasons",
    "limitations",
    "summary_markdown"
  ],
  "properties": {
    "plan_schema_version": { "const": 2 },
    "skill": { "$ref": "#/$defs/skill" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "mode": { "const": "dry_run" },
    "profile": { "$ref": "#/$defs/profile" },
    "request": { "$ref": "#/$defs/request" },
    "fetch": { "$ref": "#/$defs/fetch" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "excluded": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "blocking_reasons": { "$ref": "#/$defs/messages" },
    "limitations": { "$ref": "#/$defs/messages" },
    "summary_markdown": { "type": "string", "minLength": 1, "maxLength": 20000 }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "cmate-worktree-cleanup" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "git_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
    "worktree_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "messages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verified", "base", "remote"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "verified": { "type": "boolean" },
        "base": { "$ref": "#/$defs/git_ref" },
        "remote": { "type": "string", "minLength": 1, "maxLength": 100 },
        "baseline": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_mode", "targets"],
      "properties": {
        "selection_mode": { "enum": ["issues", "all_eligible"] },
        "targets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded", "remote", "base"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": "boolean" },
        "remote": { "type": "string", "minLength": 1, "maxLength": 100 },
        "base": { "$ref": "#/$defs/git_ref" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "base"],
      "properties": {
        "type": { "enum": ["direct", "merged_equivalent", "unverifiable"] },
        "base": { "$ref": "#/$defs/git_ref" },
        "ancestor_verified": { "type": ["boolean", "null"] },
        "pr_number": { "type": ["integer", "null"], "minimum": 1 },
        "merged_pr_exact": { "type": ["boolean", "null"] },
        "head_oid_match": { "type": ["boolean", "null"] },
        "merge_commit_oid": { "anyOf": [{ "$ref": "#/$defs/git_oid" }, { "type": "null" }] },
        "merge_commit_reachable": { "type": ["boolean", "null"] },
        "tree_equal": { "type": ["boolean", "null"] },
        "unverifiable_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/unverifiable_reason" }
        }
      }
    },
    "unverifiable_reason": {
      "enum": [
        "fetch_failed",
        "github_data_missing",
        "no_merged_pr",
        "multiple_prs",
        "head_oid_drift",
        "merge_commit_unreachable",
        "tree_mismatch",
        "command_failed"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_ref",
        "branch",
        "tip",
        "state",
        "proof",
        "decision",
        "delete_method",
        "skip_reason",
        "diagnostics"
      ],
      "properties": {
        "worktree_ref": { "$ref": "#/$defs/worktree_ref" },
        "issue_number": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 },
        "branch": { "anyOf": [{ "$ref": "#/$defs/git_ref" }, { "type": "null" }] },
        "tip": { "anyOf": [{ "$ref": "#/$defs/git_oid" }, { "type": "null" }] },
        "state": { "enum": ["clean", "dirty", "detached", "locked", "missing"] },
        "proof": { "$ref": "#/$defs/proof" },
        "decision": { "enum": ["delete", "skip"] },
        "delete_method": {
          "type": ["string", "null"],
          "enum": ["direct_branch_d", "guarded_ref_delete", null]
        },
        "skip_reason": {
          "anyOf": [{ "$ref": "#/$defs/skip_reason" }, { "type": "null" }]
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_ref", "reason"],
      "properties": {
        "worktree_ref": { "$ref": "#/$defs/worktree_ref" },
        "reason": {
          "enum": ["current_worktree", "main_worktree", "integration_worktree", "not_in_scope"]
        }
      }
    },
    "skip_reason": {
      "enum": [
        "dirty",
        "detached",
        "unmerged",
        "unverifiable",
        "fetch_failed",
        "github_data_missing",
        "no_merged_pr",
        "multiple_prs",
        "head_oid_drift",
        "merge_commit_unreachable",
        "tree_mismatch",
        "locked",
        "missing",
        "command_failed"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observation"],
      "properties": {
        "kind": { "enum": ["server", "process", "tmux", "database", "log"] },
        "observation": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
