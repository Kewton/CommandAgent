{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commandagent.verification_spec.preflight_v4_a5",
  "title": "CommandAgent VerificationSpec v0 proposal with Phase 6 v4 A5 bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "goal",
    "intent",
    "profile",
    "generation",
    "claims",
    "oracles"
  ],
  "properties": {
    "schema_version": {
      "const": "commandagent.verification_spec.v0"
    },
    "prompt_version": {
      "const": "commandagent.verification_spec.prompt.v0"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "intent": {
      "enum": [
        "create",
        "fix",
        "investigate"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/oracle"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "request_id",
        "raw_response_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "raw_response_sha256": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "normalized_requirement",
        "required",
        "kind",
        "oracle_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/goalOrigin"
            },
            {
              "$ref": "#/$defs/fixOrigin"
            },
            {
              "$ref": "#/$defs/investigationOrigin"
            }
          ]
        },
        "normalized_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "required": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "behavior",
            "state",
            "negative_condition",
            "regression",
            "reproducer_observation",
            "diagnosis_binding"
          ]
        },
        "oracle_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unverifiable_reason": {
          "enum": [
            "executor_capability_unavailable",
            "safe_execution_unavailable",
            "workspace_binding_unavailable"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "oracle_ids": {
              "minItems": 1
            }
          },
          "not": {
            "required": [
              "unverifiable_reason"
            ]
          }
        },
        {
          "required": [
            "unverifiable_reason"
          ],
          "properties": {
            "oracle_ids": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "goalOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "source_kind": {
          "const": "goal"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fixOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "artifact_path",
        "requirement_id",
        "stage",
        "expected_polarity",
        "lineage",
        "epoch"
      ],
      "properties": {
        "source_kind": {
          "const": "fix_requirement"
        },
        "artifact_path": {
          "$ref": "#/$defs/safePath"
        },
        "requirement_id": {
          "enum": [
            "before_fails",
            "after_passes",
            "no_regression"
          ]
        },
        "stage": {
          "enum": [
            "before",
            "after"
          ]
        },
        "expected_polarity": {
          "$ref": "#/$defs/polarity"
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "investigationOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "artifact_path",
        "requirement_id",
        "binding_id",
        "stage",
        "lineage",
        "epoch"
      ],
      "properties": {
        "source_kind": {
          "const": "investigation_requirement"
        },
        "artifact_path": {
          "$ref": "#/$defs/safePath"
        },
        "requirement_id": {
          "enum": [
            "reproducer_fails",
            "diagnosis_bound"
          ]
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "reproduce",
            "diagnosis"
          ]
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "polarity": {
      "enum": [
        "success",
        "failure",
        "present",
        "absent"
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim_id",
        "strategy",
        "expected_polarity",
        "minimum_strength",
        "observed_strength",
        "setup",
        "input",
        "observation",
        "timeout_ms",
        "lifecycle",
        "result",
        "lineage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "strategy": {
          "enum": [
            "command",
            "fixture",
            "exit_code",
            "stdout",
            "stderr",
            "file",
            "http",
            "dom",
            "interaction",
            "existing_fix_evidence",
            "existing_investigation_binding"
          ]
        },
        "expected_polarity": {
          "$ref": "#/$defs/polarity"
        },
        "minimum_strength": {
          "enum": [
            "weak",
            "deterministic",
            "runtime"
          ]
        },
        "observed_strength": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "weak",
            "deterministic",
            "runtime",
            null
          ]
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "lifecycle": {
          "enum": [
            "proposed",
            "validated",
            "bound",
            "executed",
            "blocked",
            "unverified"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "unverified",
            "blocked",
            "oracle_error"
          ]
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "fixture_paths"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "cwd": {
          "$ref": "#/$defs/safePath"
        },
        "fixture_paths": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/safePath"
          }
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "fixture"
            },
            "path": {
              "$ref": "#/$defs/safePath"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "method",
            "port",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "http"
            },
            "method": {
              "enum": [
                "GET",
                "HEAD"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "route",
            "selector",
            "port"
          ],
          "properties": {
            "kind": {
              "const": "dom"
            },
            "route": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "selector": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "actions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "selector"
                ],
                "properties": {
                  "kind": {
                    "const": "click"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "repeat": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  }
                }
              }
            },
            "property": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expected"
          ],
          "properties": {
            "kind": {
              "const": "exit_code"
            },
            "expected": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expected"
          ],
          "properties": {
            "kind": {
              "enum": [
                "stdout",
                "stderr",
                "dom",
                "interaction"
              ]
            },
            "expected": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "exists"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/safePath"
            },
            "exists": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expected"
          ],
          "properties": {
            "kind": {
              "const": "http_status"
            },
            "expected": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact_path"
          ],
          "properties": {
            "kind": {
              "const": "existing_binding"
            },
            "artifact_path": {
              "$ref": "#/$defs/safePath"
            }
          }
        }
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_binding_sha256",
        "concretized_binding_sha256",
        "semantic_equivalence",
        "repair_kind"
      ],
      "properties": {
        "proposed_binding_sha256": {
          "$ref": "#/$defs/hash"
        },
        "concretized_binding_sha256": {
          "$ref": "#/$defs/hash"
        },
        "semantic_equivalence": {
          "type": "boolean"
        },
        "repair_kind": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
